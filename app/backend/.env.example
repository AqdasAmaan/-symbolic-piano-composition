# Absolute path to the fine-tuned model checkpoint folder
MODEL_PATH=

# Model inference device: auto, cpu, cuda
DEVICE=auto

# --- Optional -----------------------------------------------------------

# Tokenizer config. Default: <project root>/configs/tokenizer.json
# TOKENIZER_PATH=

# Where generated MIDI files are written temporarily.
# Default: <project root>/outputs/finetuned
# OUTPUT_DIR=

# Browser origins allowed to call the API (comma-separated). Only needed
# when the frontend is hosted on a different address than the backend.
# Default: http://localhost:5173 and http://127.0.0.1:5173
# ALLOWED_ORIGINS=https://my-app.example.com

# Folder of the built frontend ("dist"). When set, this app also serves
# the website, so one address hosts everything (no CORS needed).
# FRONTEND_DIST=